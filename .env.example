# Sleeper username (required)
SLEEPER_USERNAME=your_sleeper_username

# Yahoo Fantasy API credentials (https://developer.yahoo.com/apps/)
# Copy this file to .env and fill in your values. Never commit .env.
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_REDIRECT_URI=https://localhost:8080/callback

# Your Yahoo league id: the number in football.fantasysports.yahoo.com/f1/<league_id>
YAHOO_LEAGUE_ID=your_league_id_here
